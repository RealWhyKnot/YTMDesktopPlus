abi <abi/4.0>,

include <tunables/global>

profile ytmdesktop-plus /usr/lib/ytmdesktop-plus/ytmdesktop-plus flags=(unconfined) {
  userns,

  include if exists <local/ytmdesktop-plus>
}

profile ytmdesktop-plus-appimage /opt/YTMDesktopPlus/*.AppImage flags=(unconfined) {
  userns,

  include if exists <local/ytmdesktop-plus-appimage>
}
