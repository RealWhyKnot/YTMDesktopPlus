{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "~shared/*": [
        "./src/shared/*"
      ],
      "~assets/*": [
        "./src/assets/*"
      ]
    }
  },
  "include": ["src", "vite.d.ts"],
  "exclude": ["node_modules", ".vite", "out", "dist"]
}
