{
  "extends": "./.github/lint/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "~shared/*": ["./src/shared/*"],
      "~assets/*": ["./src/assets/*"]
    }
  },
  "include": ["src", "vite.d.ts", "*.config.ts", "viteconfig", "forge.env.d.ts"],
  "exclude": ["node_modules", ".vite", "out", "dist"]
}
