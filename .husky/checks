#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

node .yarn/releases/yarn-4.18.0.cjs typecheck
node .yarn/releases/yarn-4.18.0.cjs lint
git ls-files -z --cached --others --exclude-standard \
  | xargs -0 -r -n 150 node .yarn/releases/yarn-4.18.0.cjs exec prettier \
    --check --ignore-unknown --no-error-on-unmatched-pattern --log-level warn
node .yarn/releases/yarn-4.18.0.cjs lint:css
node .yarn/releases/yarn-4.18.0.cjs test
python -B .github/lint/style_check.py
pwsh -NoProfile -File .github/lint/Invoke-PSLint.ps1

case ${OSTYPE} in
  msys* | cygwin*)
    worktree=$(pwd -W)
    MSYS_NO_PATHCONV=1 timeout 60s wsl.exe -d agent --cd "${worktree}" -- bash .husky/check-shell
    ;;
  *) bash .husky/check-shell ;;
esac
