subject=$(grep -m1 -vE '^(#|$)' "$1" || true)
case "$subject" in
  ''|Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|refactor|perf|style|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "commit-msg: \"$subject\" is not a conventional commit, use type(scope): description" >&2
  exit 1
fi
