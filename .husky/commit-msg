#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

subject=$(awk '!/^(#|$)/ { print; exit }' "${1}")
case ${subject} in
  '' | Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
  *) ;;
esac
pattern='^(feat|fix|refactor|perf|style|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if printf '%s\n' "${subject}" | grep -qE "${pattern}"; then
  exit 0
else
  printf 'commit-msg: "%s" is not a conventional commit, use type(scope): description\n' "${subject}" >&2
  exit 1
fi
